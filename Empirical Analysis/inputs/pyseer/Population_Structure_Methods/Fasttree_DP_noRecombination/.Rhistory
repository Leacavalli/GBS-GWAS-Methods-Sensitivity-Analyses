### DB-GWAS
DBGWAS_gubbins <- read.table("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Analysis/Gubbins/Fulltree/PYSEER/DBGWAS_gubbins.txt", sep = "\t", header=T) |>
filter(af >=0.05, af <0.95)
# Load Annotations
DBGWAS_gubbins_annotations <- read.delim("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Analysis/Gubbins/Fulltree/PYSEER/DBGWAS_gubbins_annotation.txt", sep = "\t", header=F)
colnames(DBGWAS_gubbins_annotations) <- colnames(DBGWAS_gubbins)
DBGWAS_gubbins_annotations <- DBGWAS_gubbins_annotations |>
filter(af >=0.05, af <0.95)|>
mutate(core_accessory = ifelse(str_extract(notes, "^[^:]+")=="AP018935.1", "core", "accessory"),
coord_range = str_extract(notes, "(?<=:)[0-9]+-[0-9]+"),
POS = as.integer(str_extract(coord_range, "^[0-9]+")),
OR = exp(beta),
OR_pos =ifelse(OR<1, "OR<1", "OR>1"))  |>
separate(
notes,
into = c("contig_position", "upstream", "gene", "downstream"),
sep = ";",
remove = FALSE,
fill = "right"
)
# Get significant hits
sig_DBGWAS_gubbins <- DBGWAS_gubbins_annotations |>
filter(lrt.pvalue < 0.05 / nrow(DBGWAS_gubbins_annotations )) |>
mutate(OR_lower = exp(beta - 1.96 * beta.std.err),
OR_upper = exp(beta + 1.96 * beta.std.err),
OR_CI = sprintf("%.2f (%.2f; %.2f)", OR, OR_lower, OR_upper),
name = paste0(gene, "_", af))|>
select(variant,af, filter.pvalue, lrt.pvalue,   OR_CI, coord_range, gene, name)
# Load Unitig distribution across samples
Sig_Unitig <- read.delim("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Analysis/Pyseer Results/Nextflow_pipeline_EOD_LOD_VLOD_CDC/15.2.Subanalysis_1/15.2.11.Recombination-free_phylo/Sig_Unitigs_Recomb.txt", sep=" ", header=F)|>
select(-V2)
Sig_Unitig[] <- lapply(Sig_Unitig, function(x) gsub(":1", "", x))
Sig_Unitig_name <- left_join(Sig_Unitig |> rename(variant =V1), sig_DBGWAS_gubbins|> select(variant, name))
Unitig_sig_t <- metadata_tree_v0 %>% select(label)
for(i in 1:nrow(Sig_Unitig_name)){
present_samples <- as.vector(unlist(Sig_Unitig_name[i, -c(1, ncol(Sig_Unitig_name))]))
new_var <- ifelse(Unitig_sig_t$label %in% present_samples, 1, 0)
Unitig_sig_t[[Sig_Unitig_name$name[i]]] <- new_var
}
row.names(Unitig_sig_t) <- Unitig_sig_t$label
Unitig_sig_t <- Unitig_sig_t[,-1]
round(colMeans(Unitig_sig_t %>% select(starts_with("Unitig_"))),3)
## Prep heatmaps
Metadata_Unitig_1 <- Unitig_sig_t |> select("_0.329")  |>  mutate(`_0.329` = ifelse(`_0.329`==0, "absent", "present"))
Metadata_Unitig_2 <- Unitig_sig_t |> select("cds-BBG32913.1_0.329") |>  mutate(`cds-BBG32913.1_0.329` = ifelse(`cds-BBG32913.1_0.329`==0, "absent", "present"))
Metadata_Unitig_3 <- Unitig_sig_t |> select("cds-BBG32943.1_0.891") |>  mutate(`cds-BBG32943.1_0.891` = ifelse(`cds-BBG32943.1_0.891`==0, "absent", "present"))
Metadata_Unitig_4 <- Unitig_sig_t |> select("cpsB_0.321") |>  mutate(`cpsB_0.321` = ifelse(`cpsB_0.321`==0, "absent", "present"))
Metadata_Unitig_5 <- Unitig_sig_t |> select("rfbC_0.855") |>  mutate(`rfbC_0.855` = ifelse(`rfbC_0.855`==0, "absent", "present"))
