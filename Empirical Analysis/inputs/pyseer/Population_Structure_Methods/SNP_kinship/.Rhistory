x = Inf, y = Inf,
hjust = 1.1, vjust = 1.5,
label = paste0("r = ", r_val, "\nP = ", p_val),
size = 4
) +
labs(
x = "log10(number of significant hits + 1)",
y = expression(lambda[GC]),
color = "GWAS type"
) +
theme_classic()
