library(ggplot2)
library(broom)
## 1. Compute correlation per GWAS type
corr_by_type <- joint_df %>%
group_by(GWAS_type) %>%
reframe(
tidy(
cor.test(log10(nhits + 1), lambdaGC, method = "pearson")
)
) %>%
mutate(
r_lab = round(estimate, 3),
p_lab = signif(p.value, 3),
label = paste0("r = ", r_lab, "\nP = ", p_lab)
)
