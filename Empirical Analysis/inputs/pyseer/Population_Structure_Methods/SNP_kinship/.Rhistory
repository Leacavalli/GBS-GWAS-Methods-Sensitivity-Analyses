# Load GWAS results
PanGWAS_ROARY <- read.table("~/GitHub/GBS-GWAS-CDC-EOD-LOD/Analysis/Pyseer Results/Nextflow_pipeline_EOD_LOD_VLOD_CDC/15.3.Subanalysis_2/PanGWAS_ROARY.txt", sep = "\t", header=T) |>
filter(af >=0.05, af <0.95)
# Get significant hits
PanGWAS_ROARY_sig <- PanGWAS_ROARY |>
filter(lrt.pvalue < 0.05 / nrow(PanGWAS_ROARY)) |>
mutate(
OR = exp(beta),
OR_lower = exp(beta - 1.96 * beta.std.err),
OR_upper = exp(beta + 1.96 * beta.std.err),
OR_CI = sprintf("%.2f (%.2f; %.2f)", OR, OR_lower, OR_upper),
P_value = formatC(lrt.pvalue, format = "e", digits = 2)
) |>
select(variant, OR_CI, P_value)
PanGWAS_ROARY_sig
# QQ plot
