(818+85)/(818+85+637)
SNPGWAS_ann_df |>
filter(lrt.pvalue < 0.05 /nrow(SNPGWAS_ann_df)) |>
mutate(expbeta = exp(beta),
expbeta_lower = exp(beta - 1.96 * beta.std.err),
expbeta_upper = exp(beta + 1.96 * beta.std.err),
variant2= paste0(REF, POS,ALT))|>
select(variant2 , af, expbeta, expbeta_lower, expbeta_upper)|>
rename(variant=variant2)
unitig_df <- DBGWAS_ann |>
filter(lrt.pvalue < 0.05 / 87899) |>
mutate(ref_unaligned = factor(ref_unaligned, levels= c("ref genome", "unaligned contig")))|>
arrange(ref_unaligned, as.numeric(start))|>
mutate(expbeta = exp(beta),
expbeta_lower = exp(beta - 1.96 * beta.std.err),
expbeta_upper = exp(beta + 1.96 * beta.std.err),OR = (af+expbeta)/af,
variant= paste0("Unitig ",row_number()))|>
select(variant , af, expbeta, expbeta_lower, expbeta_upper)
unitig_df
cog_df <- PanGWAS_data |>
filter(lrt.pvalue < 0.05 / nrow(PanGWAS_data)) |>
mutate(K=0.5,
expbeta = exp(beta),
expbeta_lower = exp(beta - 1.96 * beta.std.err),
expbeta_upper = exp(beta + 1.96 * beta.std.err),OR = (af+expbeta)/af)|>
select(variant , af, expbeta, expbeta_lower, expbeta_upper)
